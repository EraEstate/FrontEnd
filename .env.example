# --- Production (Vercel) — BẮT BUỘC thêm các biến dưới đây vào:
# Vercel → Project → Settings → Environment Variables → Production (và Preview nếu cần)
# Không commit file .env.production chứa URL; build trên Vercel lấy từ dashboard.

VITE_API_BASE_URL=https://king-prawn-app-2t4wy.ondigitalocean.app/api
VITE_API_URL=https://king-prawn-app-2t4wy.ondigitalocean.app
VITE_WS_BASE_URL=https://king-prawn-app-2t4wy.ondigitalocean.app/ws

# Blockchain (tùy môi trường — thêm trên Vercel nếu dùng)
# VITE_BLOCKCHAIN_NETWORK_NAME=
# VITE_BLOCKCHAIN_EXPLORER_URL=
# VITE_REALESTATE_CONTRACT_ADDRESS=

# VNPAY (nếu dùng)
# VITE_VNPAY_SERVER_URL=

# Local: copy file này thành .env.production.local (đã gitignore) nếu cần chạy `npm run build` trỏ production API.
